{% extends 'base.html.twig' %}

{% block title %}Les groupes politiques — ScrutinClair{% endblock %}
{% block description %}Tous les groupes politiques de l'Assemblée nationale : effectifs, position et votes.{% endblock %}

{% block body %}
    <header class="page-head">
        <span class="hero__eyebrow">Assemblée nationale</span>
        <h1>Les groupes politiques</h1>
        <p>De la gauche à la droite de l'hémicycle, découvrez les groupes de la 17<sup>e</sup> législature, leurs effectifs et leurs votes.</p>
    </header>

    <section class="groupes" aria-label="Groupes politiques">
        {% for groupe in groupes %}
            <a class="groupe-card" href="{{ path('app_partis_show', { uid: groupe.uid }) }}"
               style="--groupe-couleur: {{ groupe.couleur }}">
                <span class="groupe-card__chip">{{ groupe.acronyme }}</span>
                <span class="groupe-card__nom">{{ groupe.nom }}</span>
                <span class="groupe-card__meta">{{ groupe.personnalites|length }} membre{{ groupe.personnalites|length > 1 ? 's' : '' }}</span>
                <span class="groupe-card__chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
                </span>
            </a>
        {% else %}
            <p class="empty-state">Aucun groupe politique enregistré.</p>
        {% endfor %}
    </section>
{% endblock %}
