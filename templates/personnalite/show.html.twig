{% extends 'base.html.twig' %}

{% block title %}{{ personnalite.nomComplet }} — ScrutinClair{% endblock %}
{% block description %}{{ personnalite.nomComplet }}{% if personnalite.groupePolitique %}, {{ personnalite.groupePolitique.nom }}{% elseif personnalite.groupePolitiqueSenat %}, {{ personnalite.groupePolitiqueSenat.nom }}{% endif %} : votes, propositions et projets de loi.{% endblock %}

{% block body %}
    {% set age = personnalite.dateNaissance ? date().diff(personnalite.dateNaissance).y : null %}
    {% set groupePrincipal = personnalite.groupePolitique ?? personnalite.groupePolitiqueSenat %}

    <a class="backlink" href="{{ path('app_personnalites') }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
        Toutes les personnalités
    </a>

    <header class="detail-head detail-head--person" style="--groupe-couleur: {{ groupePrincipal ? groupePrincipal.couleur : '#9ca3af' }}">
        {{ include('components/_avatar.html.twig', { personne: personnalite }) }}
        <div class="detail-head__body">
            <h1>{{ personnalite.nomComplet }}</h1>
            <p class="detail-head__meta">
                {% if personnalite.groupePolitique %}
                    <a class="chip" href="{{ path('app_partis_show', { uid: personnalite.groupePolitique.uid }) }}"
                       style="--groupe-couleur: {{ personnalite.groupePolitique.couleur }}">{{ personnalite.groupePolitique.libelleCourt }}</a>
                {% endif %}
                {% if personnalite.groupePolitiqueSenat %}
                    <a class="chip" href="{{ path('app_partis_show', { uid: personnalite.groupePolitiqueSenat.uid }) }}"
                       style="--groupe-couleur: {{ personnalite.groupePolitiqueSenat.couleur }}">{{ personnalite.groupePolitiqueSenat.libelleCourt }} <small>Sénat</small></a>
                {% endif %}
                {% if personnalite.fonction %}<span>{{ personnalite.fonction }}</span>{% endif %}
                {% if personnalite.circonscription %}<span>·</span><span>{{ personnalite.circonscription }}</span>{% endif %}
                {% if personnalite.circonscriptionSenat %}<span>·</span><span>{{ personnalite.circonscriptionSenat }} <small>Sénat</small></span>{% endif %}
            </p>
            <dl class="facts">
                {% if personnalite.dateNaissance %}
                    <div><dt>Naissance</dt><dd>{{ personnalite.dateNaissance|date('d/m/Y') }}{% if age %} ({{ age }} ans){% endif %}</dd></div>
                {% endif %}
                {% if personnalite.profession %}
                    <div><dt>Profession</dt><dd>{{ personnalite.profession }}</dd></div>
                {% endif %}
                <div><dt>Votes enregistrés</dt><dd>{{ total|number_format(0, ',', ' ') }}</dd></div>
            </dl>
        </div>
    </header>

    <section class="card">
        <div class="card__head">
            <span class="card__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20a8 8 0 0 1 16 0"></path><path d="M12 12v-4"></path><path d="M9 20v-4"></path><path d="M15 20v-4"></path></svg>
            </span>
            <h2>Ses votes</h2>
        </div>

        {% if total > 0 %}
            {{ include('components/_statbar.html.twig', { stats: stats }) }}

            {% if themesVotes %}
                <div class="theme-votes">
                    <h3 class="theme-votes__titre">Votes par thème</h3>
                    <p class="theme-votes__aide">Un texte peut relever de plusieurs thèmes.</p>

                    {% for groupe in themesVotes %}
                        <details class="theme-votes__groupe"{% if loop.first %} open{% endif %}>
                            <summary class="theme-votes__resume">
                                <span class="theme-chip" style="--theme-couleur: {{ groupe.tag.couleur }}">{{ groupe.tag.nom }}</span>
                                <span class="theme-votes__ratio">
                                    <strong class="theme-votes__pour">{{ groupe.stats.pour }}</strong> pour ·
                                    <strong class="theme-votes__contre">{{ groupe.stats.contre }}</strong> contre
                                    {% if groupe.stats.abstention %} · {{ groupe.stats.abstention }} abst.{% endif %}
                                </span>
                            </summary>

                            <ul class="scrutins">
                                {% for vote in groupe.votes %}
                                    <li class="scrutin">
                                        <a class="scrutin__titre" href="{{ path('app_texte_show', { id: vote.texteId }) }}">
                                            {{ vote.titreCourt ?? (vote.objet ?? vote.titre)|titre_court }}
                                        </a>
                                        <span class="scrutin__vote scrutin__vote--{{ vote.statut|lower }}">{{ vote.statut }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </details>
                    {% endfor %}
                </div>
            {% endif %}

            {% if votesSansTag %}
                <div class="theme-votes theme-votes--sans">
                    <h3 class="theme-votes__titre">
                        Autres votes
                        <span class="theme-votes__count">{{ totalSansTag|number_format(0, ',', ' ') }}</span>
                    </h3>
                    <p class="theme-votes__aide">Textes pas encore rattachés à un thème.</p>

                    <ul class="scrutins">
                        {% for vote in votesSansTag %}
                            <li class="scrutin">
                                <a class="scrutin__titre" href="{{ path('app_texte_show', { id: vote.texte.id }) }}">
                                    {{ vote.texte.titreCourt ?? (vote.texte.titreLong|titre_court) }}
                                </a>
                                <span class="scrutin__vote scrutin__vote--{{ vote.statut|lower }}">{{ vote.statut }}</span>
                            </li>
                        {% endfor %}
                    </ul>

                    {{ include('components/_pagination.html.twig', {
                        route: 'app_personnalites_show',
                        params: { uid: personnalite.uid },
                        page: page,
                        pages: pages,
                    }) }}
                </div>
            {% endif %}
        {% else %}
            <p class="empty-state">Aucun vote enregistré pour cette personne.</p>
        {% endif %}
    </section>

    <section class="card">
        <div class="card__head">
            <span class="card__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"></path><path d="M15 3v4h4"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></svg>
            </span>
            <h2>Propositions de loi</h2>
            <span class="card__count">{{ propositions|length }}</span>
        </div>

        {% if propositions %}
            <ul class="propositions">
                {% for proposition in propositions %}
                    {% set texteId = texteIdsParDossier[proposition.dossierRef] ?? null %}
                    <li class="proposition">
                        <a class="proposition__titre" href="{{ texteId ? path('app_texte_show', { id: texteId }) : proposition.lien }}"{% if not texteId %} target="_blank" rel="noopener"{% endif %}>
                            {{ proposition.titre }}
                        </a>
                        <span class="proposition__meta">
                            {% if proposition.qualite == 'cosignataire' %}
                                <span class="proposition__badge">Cosignataire</span>
                            {% endif %}
                            {% if proposition.dateDepot %}Déposée le {{ proposition.dateDepot|date('d/m/Y') }}{% endif %}
                            <span class="proposition__source">{{ texteId ? 'Fiche ScrutinClair' : 'Texte officiel (Assemblée nationale)' }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="empty-state">Aucune proposition de loi déposée ou cosignée par cette personnalité n'a été trouvée.</p>
        {% endif %}
    </section>

    {% if projets %}
        <section class="card">
            <div class="card__head">
                <span class="card__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"></path><path d="M15 3v4h4"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></svg>
                </span>
                <h2>Projets de loi</h2>
                <span class="card__count">{{ projets|length }}</span>
            </div>

            <ul class="propositions">
                {% for projet in projets %}
                    {% set texteId = texteIdsParDossier[projet.dossierRef] ?? null %}
                    <li class="proposition">
                        <a class="proposition__titre" href="{{ texteId ? path('app_texte_show', { id: texteId }) : projet.lien }}"{% if not texteId %} target="_blank" rel="noopener"{% endif %}>
                            {{ projet.titre }}
                        </a>
                        <span class="proposition__meta">
                            {% if projet.dateDepot %}Déposé le {{ projet.dateDepot|date('d/m/Y') }}{% endif %}
                            <span class="proposition__source">{{ texteId ? 'Fiche ScrutinClair' : 'Texte officiel (Assemblée nationale)' }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
