{% extends 'base.html.twig' %}

{% block title %}Les personnalités politiques — ScrutinClair{% endblock %}
{% block description %}Retrouvez les députés de l'Assemblée nationale : leurs votes et leurs propositions de loi.{% endblock %}

{% block body %}
    <header class="page-head">
        <span class="hero__eyebrow">Assemblée nationale</span>
        <h1>Les personnalités politiques</h1>
        <p>Recherchez un député par son nom et découvrez ses votes et ses propositions de loi.</p>

        <form class="search" action="{{ path('app_personnalites') }}" method="GET" role="search">
            <label class="search__label" for="personnalite-search">Rechercher un député par nom ou prénom.</label>
            <div class="search__field">
                <span class="search__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </span>
                <input type="search" id="personnalite-search" name="q" value="{{ q }}"
                       placeholder="Ex. Maudet, Rimbert…" autocomplete="off">
                <button type="submit" class="search__submit" aria-label="Rechercher">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
                </button>
            </div>
        </form>
    </header>

    <div class="section-title">
        <h2>{{ q != '' ? 'Résultats' : 'Tous les députés' }}</h2>
        <span>{{ personnalites|length }} personne{{ personnalites|length > 1 ? 's' : '' }}{{ q != '' ? ' pour « ' ~ q ~ ' »' }}</span>
    </div>

    {% if personnalites %}
        <ul class="member-grid">
            {% for membre in personnalites %}
                <li>
                    <a class="member" href="{{ path('app_personnalites_show', { uid: membre.uid }) }}">
                        {{ include('components/_avatar.html.twig', { personne: membre, classe: 'member__avatar' }) }}
                        <span class="member__body">
                            <span class="member__nom">{{ membre.nomComplet }}</span>
                            <span class="member__meta">
                                {% if membre.groupePolitique %}{{ membre.groupePolitique.libelleCourt }}{% endif %}
                                {% if membre.groupePolitique and membre.circonscription %} · {% endif %}
                                {{ membre.circonscription }}
                            </span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty-state">Aucune personnalité ne correspond à «&nbsp;{{ q }}&nbsp;».</p>
    {% endif %}
{% endblock %}
