{% set data = texte.hemicyclePolitique %}

{% if data.total > 0 %}
    <div class="hemicycle-block">
        <div class="hemicycle" data-hemicycle>
            <svg class="hemicycle__svg" viewBox="0 0 400 205" role="img"
                 aria-label="Répartition des votes par groupe politique">
                {% for groupe in data.groupes %}
                    <g class="hemicycle__groupe"
                       data-parti="{{ groupe.nom }}"
                       data-parti-complet="{{ data.groupes[loop.index0].nom_complet }}"
                       data-pour="{{ groupe.pour }}"
                       data-contre="{{ groupe.contre }}"
                       data-abstention="{{ groupe.abstention }}"
                       data-total="{{ data.groupes[loop.index0].total }}">
                        {% for segment in data.groupes[loop.index0].segments %}
                            <path class="hemicycle__segment" d="{{ segment.path }}" fill="{{ segment.couleur }}"></path>
                        {% endfor %}
                    </g>
                {% endfor %}
            </svg>

            <div class="hemicycle__total">
                <strong>{{ data.total }}</strong>
                <span>Votants</span>
            </div>

            <div class="hemicycle__tooltip" role="tooltip" aria-hidden="true"></div>
        </div>

        <p class="hemicycle-summary">
            <span class="legend-pour">Pour {{ data.pour }}</span>
            <span class="legend-contre">Contre {{ data.contre }}</span>
            <span class="legend-abstention">Abstentions {{ data.abstention }}</span>
        </p>
    </div>
{% else %}
    <p class="empty-state">Aucun vote enregistré pour ce texte.</p>
{% endif %}
