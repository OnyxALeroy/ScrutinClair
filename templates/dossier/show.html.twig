{% extends 'base.html.twig' %}

{% block title %}{{ titre is not null ? titre : dossierRef }} — Dossier législatif — ScrutinClair{% endblock %}
{% block description %}Dossier législatif {{ dossierRef }} — textes, scrutins et initiatives liées.{% endblock %}

{% block body %}
    <header class="page-head">
        <span class="hero__eyebrow">Dossier législatif</span>
        <h1>{{ titre ?? dossierRef }}</h1>
        <p>Tous les textes et scrutins liés au dossier <strong>{{ dossierRef }}</strong> (Assemblée nationale &amp; Sénat).</p>
        <p>
            {% if assembleeUrl %}
                <a href="{{ assembleeUrl }}" target="_blank" rel="noopener noreferrer">Consulter le document source sur l'Assemblée nationale</a>
            {% endif %}
            {% if senatUrl %}
                {% if assembleeUrl %} · {% endif %}
                <a href="{{ senatUrl }}" target="_blank" rel="noopener noreferrer">Consulter le dossier au Sénat</a>
            {% endif %}
        </p>
    </header>

    <form method="get" class="card" style="margin-top:1rem; display:flex; gap:1rem; align-items:center;">
        <label>
            Chambre:
            <select name="chambre">
                <option value="all" {{ chambreFilter == 'all' ? 'selected' : ''}}>Tous</option>
                <option value="AN" {{ chambreFilter == 'AN' ? 'selected' : ''}}>Assemblée nationale</option>
                <option value="SENAT" {{ chambreFilter == 'SENAT' ? 'selected' : ''}}>Sénat</option>
            </select>
        </label>
        <label>
            Trier par:
            <select name="sort">
                <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : ''}}>Date (plus récent)</option>
                <option value="date_asc" {{ sort == 'date_asc' ? 'selected' : ''}}>Date (plus ancien)</option>
                <option value="title_asc" {{ sort == 'title_asc' ? 'selected' : ''}}>Titre A→Z</option>
                <option value="title_desc" {{ sort == 'title_desc' ? 'selected' : ''}}>Titre Z→A</option>
            </select>
        </label>
        <button class="button">Filtrer</button>
    </form>

    <section class="card">
        <h2>Textes et scrutins liés</h2>

        {% if showAn %}
        <h3>Assemblée nationale ({{ totalAn }})</h3>
        {% if textesAn is empty %}
            <p>Aucun texte importé pour l'Assemblée nationale dans ce dossier.</p>
        {% else %}
            <ul class="list-unstyled">
                {% for texte in textesAn %}
                    <li class="scrutin-item">
                        <a href="{{ path('app_texte_show', { id: texte.id }) }}">{{ texte.titre ?? texte.objet }}</a>
                        {% if texte.dateScrutin %}<small>— {{ texte.dateScrutin|date('Y-m-d') }}</small>{% endif %}
                        {% if texte.dossierRef %} <small>({{ texte.dossierRef }})</small>{% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% set maxPagesAn = (totalAn // perPage) + (totalAn % perPage > 0 ? 1 : 0) %}
            {% if maxPagesAn > 1 %}
                <nav class="pagination">
                    {% for p in 1..maxPagesAn %}
                        <a href="?page_an={{ p }}" class="{{ p == pageAn ? 'is-active' : '' }}">{{ p }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        {% endif %}
        {% else %}
            <p>Affichage de l'Assemblée nationale masqué par le filtre.</p>
        {% endif %}

        <hr/>

        {% if showSenat %}
        <h3>Sénat ({{ totalSenat }})</h3>
        {% if textesSenat is empty %}
            <p>Aucun texte importé pour le Sénat dans ce dossier.</p>
        {% else %}
            <ul class="list-unstyled">
                {% for texte in textesSenat %}
                    <li class="scrutin-item">
                        <span class="badge badge--chambre">{{ texte.chambre.label }}</span>
                        <a href="{{ path('app_texte_show', { id: texte.id }) }}">{{ texte.titre ?? texte.objet }}</a>
                        {% if texte.dateScrutin %}<small>— {{ texte.dateScrutin|date('Y-m-d') }}</small>{% endif %}
                        {% if texte.uidScrutin and texte.uidScrutin starts with 'SEN:' %}
                            {# SEN:scrYYYY-N -> JSON url via SenatUrls #}
                            {% set uid = texte.uidScrutin|replace({'SEN:':''}) %}
                            {% if uid starts with 'scr' %}
                                {% set uid2 = uid|replace({'scr':''}) %}
                                {% set parts = uid2|split('-') %}
                                {% set year = parts[0]|default('0') %}
                                {% set num = parts[1]|default('0') %}
                                <a href="{{ senatUrls.scrutinJsonUrl(year, num) }}" class="small" target="_blank" rel="noopener">(JSON du scrutin)</a>
                            {% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% set maxPagesSen = (totalSenat // perPage) + (totalSenat % perPage > 0 ? 1 : 0) %}
            {% if maxPagesSen > 1 %}
                <nav class="pagination">
                    {% for p in 1..maxPagesSen %}
                        <a href="?page_senat={{ p }}" class="{{ p == pageSenat ? 'is-active' : '' }}">{{ p }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        {% endif %}
        {% else %}
            <p>Affichage du Sénat masqué par le filtre.</p>
        {% endif %}
    </section>

    <section class="card">
        <h2>Initiatives et documents (Assemblée)</h2>
        {% if initiatives is empty %}
            <p>Aucun document opendata trouvé pour ce dossier.</p>
        {% else %}
            <ul>
                {% for doc in initiatives %}
                    <li><a href="{{ doc.lien }}" target="_blank" rel="noopener noreferrer">{{ doc.titre ?? doc.uid }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

{% endblock %}
