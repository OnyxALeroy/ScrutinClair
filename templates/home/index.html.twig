{% extends 'base.html.twig' %}

{% block title %}Rechercher un texte, un parti, une personnalité — ScrutinClair{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="flash flash--success">{{ message }}</div>
    {% endfor %}

    <section class="hero">
        <span class="hero__eyebrow">Assemblée nationale & Sénat</span>
        <h1>Comprendre la vie parlementaire <span class="hero__accent">en clair</span></h1>
        <p>Cherchez un texte de loi, un groupe politique ou une personnalité, et découvrez l’essentiel expliqué simplement.</p>

        <form class="search" action="{{ path('app_home') }}" method="GET" role="search" autocomplete="off"
              data-recherche-api="{{ path('app_recherche') }}">
            <label class="search__label" for="texte-search">Rechercher un texte, un groupe politique ou une personnalité.</label>
            <div class="search__field">
                <span class="search__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="search" id="texte-search" name="q" value="{{ q }}"
                       placeholder="Ex. projet de loi de finances, RN, Lecornu…"
                       autocomplete="off" aria-autocomplete="list" aria-controls="texte-suggestions" aria-expanded="false">
                <button type="submit" class="search__submit" aria-label="Rechercher">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>
                </button>
            </div>
            <ul id="texte-suggestions" class="search__list" role="listbox"></ul>
        </form>
    </section>

    {% if q != '' %}
        {% set totalResultats = textes|length + groupes|length + personnalites|length %}

        <div class="section-title">
            <h2>Résultats</h2>
            <span>{{ totalResultats }} résultat{{ totalResultats > 1 ? 's' : '' }} pour « {{ q }} »</span>
        </div>

        {% if totalResultats == 0 %}
            <p class="empty-state">Aucun résultat ne correspond à «&nbsp;{{ q }}&nbsp;».</p>
        {% endif %}

        {% if groupes %}
            <section class="result-bloc" aria-label="Groupes politiques">
                <h3 class="result-bloc__title">Groupes politiques</h3>
                <ul class="groupes groupes--compact">
                    {% for groupe in groupes %}
                        <li>
                            <a class="groupe-card" href="{{ path('app_partis_show', { uid: groupe.uid }) }}"
                               style="--groupe-couleur: {{ groupe.couleur }}">
                                <span class="groupe-card__chip">{{ groupe.acronyme }}</span>
                                <span class="groupe-card__nom">{{ groupe.nom }}</span>
                                <span class="groupe-card__meta">{{ groupe.personnalites|length }} membre{{ groupe.personnalites|length > 1 ? 's' : '' }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </section>
            </section>
        {% endif %}

        {% if personnalites %}
            <section class="result-bloc" aria-label="Personnalités politiques">
                <h3 class="result-bloc__title">Personnalités</h3>
                <ul class="member-grid">
                    {% for membre in personnalites %}
                        <li>
                            <a class="member" href="{{ path('app_personnalites_show', { uid: membre.uid }) }}">
                                <span class="member__avatar" aria-hidden="true">{{ membre.prenom|first }}{{ membre.nom|first }}</span>
                                <span class="member__body">
                                    <span class="member__nom">{{ membre.nomComplet }}</span>
                                    <span class="member__meta">
                                        {% if membre.groupePolitique %}{{ membre.groupePolitique.libelleCourt }}{% elseif membre.groupePolitiqueSenat %}{{ membre.groupePolitiqueSenat.libelleCourt }} <small>Sénat</small>{% elseif membre.fonction %}{{ membre.fonction }}{% endif %}
                                        {% if membre.circonscription %} · {{ membre.circonscription }}{% endif %}
                                    </span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if textes %}
            <section class="result-bloc" aria-label="Textes de loi">
                <h3 class="result-bloc__title">Textes de loi</h3>
                <ul class="results">
                    {% for texte in textes %}
                        <li>
                            <a href="{{ path('app_texte_show', { id: texte.id }) }}">
                                <span class="results__titre">{{ texte.titreCourt ?? (texte.titreLong|titre_court) }}</span>
                                {% if texte.synthese %}<span class="synthese">{{ texte.synthese }}</span>{% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% else %}
        <section class="features" aria-label="Ce que propose ScrutinClair">
            <article class="feature">
                <span class="feature__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l1.8 4.9L19 9.5l-5.2 1.6L12 16l-1.8-4.9L5 9.5l5.2-1.6z"></path>
                        <path d="M18 16l.9 2.1L21 19l-2.1.9L18 22l-1-2.1L15 19l2-.9z"></path>
                    </svg>
                </span>
                <h3>Expliqué simplement</h3>
                <p>Chaque texte est résumé en clair, à partir du contenu officiel, pour aller à l’essentiel.</p>
            </article>
            <article class="feature">
                <span class="feature__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 20a8 8 0 0 1 16 0"></path>
                        <path d="M12 12v-4"></path>
                        <path d="M9 20v-4"></path>
                        <path d="M15 20v-4"></path>
                    </svg>
                </span>
                <h3>Les votes en un coup d’œil</h3>
                <p>Un hémicycle interactif montre la répartition des voix, groupe par groupe.</p>
            </article>
            <article class="feature">
                <span class="feature__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"></path>
                        <circle cx="9" cy="8" r="3.2"></circle>
                        <path d="M22 20v-1.5a4 4 0 0 0-3-3.85"></path>
                        <path d="M16.5 5.1a3.2 3.2 0 0 1 0 5.8"></path>
                    </svg>
                </span>
                <h3>Partis et personnalités</h3>
                <p>Explorez les groupes politiques et retrouvez les votes et les textes portés par chaque personnalité.</p>
            </article>
        </section>

        <section class="shortcuts" aria-label="Explorer">
            <a class="shortcut" href="{{ path('app_partis') }}">
                <span class="shortcut__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path></svg>
                </span>
                <span>
                    <strong>Les groupes politiques</strong>
                    <small>Effectifs et votes de chaque parti</small>
                </span>
            </a>
            <a class="shortcut" href="{{ path('app_gouvernements') }}">
                <span class="shortcut__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path></svg>
                </span>
                <span>
                    <strong>Les gouvernements</strong>
                    <small>Compositions et ministres</small>
                </span>
            </a>
            <a class="shortcut" href="{{ path('app_personnalites') }}">
                <span class="shortcut__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"></path><circle cx="9" cy="8" r="3.2"></circle><path d="M22 20v-1.5a4 4 0 0 0-3-3.85"></path><path d="M16.5 5.1a3.2 3.2 0 0 1 0 5.8"></path></svg>
                </span>
                <span>
                    <strong>Les personnalités</strong>
                    <small>Votes, propositions et projets de loi</small>
                </span>
            </a>
        </section>
    {% endif %}

    <script src="/js/search.js" defer></script>
{% endblock %}
