{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {% if texte %}
        <h1>{{ texte.titre }}</h1>
        <p><em>{{ texte.description }}</em></p>

        <h2>Résultat des votes</h2>
        <ul>
            {# La magie de l'ORM : texte.votes va chercher les données dans la table Vote #}
            {% for vote in texte.votes %}
                <li>
                    <strong>{{ vote.personnalite.prenom }} {{ vote.personnalite.nom }}</strong> :
                    {{ vote.statut }}
                </li>
            {% else %}
                <li>Aucun vote enregistré.</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune texte trouvé en base de données.</p>
    {% endif %}
{% endblock %}
