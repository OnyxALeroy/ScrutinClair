{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {# Affichage des messages flash (ex: succès de l'import) #}
    {% for message in app.flashes('success') %}
        <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 5px; margin-bottom: 1rem;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1>Les Textes de l'Assemblée</h1>

        {# Le bouton d'import #}
        <form action="{{ path('app_import') }}" method="POST">
            <button type="submit" style="padding: 0.5rem 1rem; background: #0056b3; color: white; border: none; border-radius: 4px; cursor: pointer;">
                Importer les données
            </button>
        </form>
    </div>

    <hr>

    {% if texte %}
        <h1>{{ texte.titre }}</h1>
        <p><em>{{ texte.description }}</em></p>

        <h2>Résultat des votes</h2>
        <ul>
            {# La magie de l'ORM : texte.votes va chercher les données dans la table Vote #}
            {% for vote in texte.votes %}
                <li>
                    <strong>{{ vote.personalite.prenom }} {{ vote.personalite.nom }}</strong> :
                    {{ vote.statut }}
                </li>
            {% else %}
                <li>Aucun vote enregistré.</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune texte trouvé en base de données.</p>
    {% endif %}
{% endblock %}
