{% if texte %}
    {% set objetBas = (texte.objet ?? texte.titre ?? '')|lower %}

    <article>
        <header class="texte-header">
            <div class="badges">
                <span class="badge badge--type">
                    {% if 'amendement' in objetBas %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h11l5 5v11H4z"></path><path d="M15 4v5h5"></path></svg>
                        Amendement
                    {% else %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"></path><path d="M15 3v4h4"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></svg>
                        Texte de loi
                    {% endif %}
                </span>
                {% if texte.vulgarisation %}
                    <span class="badge badge--ai">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.9L19 9.5l-5.2 1.6L12 16l-1.8-4.9L5 9.5l5.2-1.6z"></path></svg>
                        Vulgarisé par IA
                    </span>
                {% endif %}
            </div>

            <h1>{{ texte.objet ?? texte.titre }}</h1>

            {% if texte.themes is not empty %}
                <div class="theme-chips">
                    {% for tag in texte.themes %}
                        <a class="theme-chip" href="{{ path('app_theme_show', { slug: tag.slug }) }}" style="--theme-couleur: {{ tag.couleur }}">
                            {{ tag.nom }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {% if texte.synthese %}
                <p class="lead">{{ texte.synthese }}</p>
            {% endif %}
            {% if texte.description %}
                <p class="lead"><em>{{ texte.description }}</em></p>
            {% endif %}
            {% if texte.lien %}
                <p class="source-block">
                    <a class="source-link" href="{{ texte.lien }}" target="_blank" rel="noopener noreferrer">
                        Consulter le scrutin sur l’Assemblée nationale
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"></path></svg>
                    </a>
                </p>
            {% endif %}
        </header>

        {% set aiActif = ai.enabled %}
        {% set vulgarisation = texte.vulgarisation %}

        <section class="vulgarisation{% if not vulgarisation %} vulgarisation--vide{% endif %}" aria-labelledby="titre-vulgarisation">
            <div class="vulgarisation__header">
                <span class="vulgarisation__icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.9L19 9.5l-5.2 1.6L12 16l-1.8-4.9L5 9.5l5.2-1.6z"></path><path d="M18 16l.9 2.1L21 19l-2.1.9L18 22l-1-2.1L15 19l2-.9z"></path></svg>
                </span>
                <h2 id="titre-vulgarisation">En clair</h2>
                {% if not vulgarisation %}
                    <span class="vulgarisation__tag">{{ aiActif ? 'Pas encore généré' : 'Indisponible' }}</span>
                {% endif %}
            </div>
            {% if vulgarisation %}
                <div class="vulgarisation__body">
                    {{ vulgarisation|markdown_to_html }}
                </div>
                {% if aiActif %}
                    <p class="ia-note">Résumé vulgarisé généré automatiquement par une intelligence artificielle. Il peut comporter des imprécisions : seul le texte officiel fait foi.</p>
                {% else %}
                    <p class="ia-note">La génération par IA est désactivée sur cette instance : ce résumé a été produit précédemment, aucun nouveau résumé ne sera généré.</p>
                {% endif %}
            {% else %}
                <p class="vulgarisation__placeholder">
                    {% if not aiActif %}
                        La génération de résumés par IA est désactivée sur cette instance : aucun rapport ne peut être généré pour ce texte.
                    {% elseif texte.vulgarisationStatut == 'error' %}
                        La génération du résumé a échoué. Elle pourra être relancée plus tard.
                    {% elseif texte.vulgarisationStatut == 'no_source' %}
                        Aucun texte de loi n'a pu être associé à ce scrutin : il n'y a donc pas de résumé à générer.
                    {% else %}
                        Ce texte n'a pas encore été vulgarisé. Le résumé en langage clair sera disponible après la génération.
                    {% endif %}
                </p>
            {% endif %}
        </section>

        <section class="card">
            <div class="card__head">
                <span class="card__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20a8 8 0 0 1 16 0"></path><path d="M12 12v-4"></path><path d="M9 20v-4"></path><path d="M15 20v-4"></path></svg>
                </span>
                <h2>Résultat des votes</h2>
            </div>
            {{ include('components/_hemicycle.html.twig', { texte: texte }) }}
        </section>

        <section class="card">
            <div class="card__head">
                <span class="card__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"></path><circle cx="9" cy="8" r="3.2"></circle><path d="M22 20v-1.5a4 4 0 0 0-3-3.85"></path><path d="M16.5 5.1a3.2 3.2 0 0 1 0 5.8"></path></svg>
                </span>
                <h2>Votes des députés</h2>
            </div>
            <div class="votes-scroll">
                <ul class="votes">
                    {% for vote in texte.votes %}
                        <li class="vote vote--{{ vote.statut|lower }}">
                            <span class="vote__nom">{{ vote.personalite ? vote.personalite.prenom ~ ' ' ~ vote.personalite.nom : 'Député non renseigné' }}</span>
                            <span class="vote__statut">{{ vote.statut }}</span>
                        </li>
                    {% else %}
                        <li class="vote__empty">Aucun vote enregistré.</li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    </article>
{% else %}
    <div class="empty-state">Aucun texte trouvé en base de données.</div>
{% endif %}
