{% extends 'base.html.twig' %}

{% block title %}Les gouvernements — ScrutinClair{% endblock %}
{% block description %}Les gouvernements de la 17e législature, du plus récent au plus ancien, et leurs membres.{% endblock %}

{% block body %}
    <header class="page-head">
        <span class="hero__eyebrow">Assemblée nationale · 17<sup>e</sup> législature</span>
        <h1>Les gouvernements</h1>
        <p>Du plus récent au plus ancien, retrouvez la composition des gouvernements et les projets de loi portés par leurs membres.</p>
    </header>

    <section class="gouvernements" aria-label="Gouvernements">
        {% for gouvernement in gouvernements %}
            {% set premierMinistre = gouvernement.premierMinistre %}
            <a class="gouvernement-card{% if gouvernement.estActuel %} gouvernement-card--actuel{% endif %}"
               href="{{ path('app_gouvernements_show', { uid: gouvernement.uid }) }}">
                <span class="gouvernement-card__badge">
                    {% if gouvernement.estActuel %}En exercice{% else %}Gouvernement{% endif %}
                </span>
                <span class="gouvernement-card__nom">{{ gouvernement.nomAffiche }}</span>
                <span class="gouvernement-card__dates">
                    {% if gouvernement.estActuel %}
                        Depuis le {{ gouvernement.dateDebut|date('d/m/Y') }}
                    {% else %}
                        Du {{ gouvernement.dateDebut|date('d/m/Y') }}
                        {% if gouvernement.dateFin %}au {{ gouvernement.dateFin|date('d/m/Y') }}{% endif %}
                    {% endif %}
                </span>
                {% if premierMinistre %}
                    <span class="gouvernement-card__pm">
                        Premier ministre : <strong>{{ premierMinistre.personnalite.nomComplet }}</strong>
                    </span>
                {% endif %}
                <span class="gouvernement-card__meta">
                    {{ gouvernement.membres|length }} membre{{ gouvernement.membres|length > 1 ? 's' : '' }}
                </span>
                <span class="gouvernement-card__chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
                </span>
            </a>
        {% else %}
            <p class="empty-state">Aucun gouvernement enregistré.</p>
        {% endfor %}
    </section>
{% endblock %}
