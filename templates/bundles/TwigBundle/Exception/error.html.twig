{% extends 'base.html.twig' %}

{% block title %}Erreur — ScrutinClair{% endblock %}
{% block description %}Une erreur est survenue.{% endblock %}

{% block body %}
    <section class="error-page">
        <span class="error-page__code" aria-hidden="true">Oups</span>
        <h1>Une erreur est survenue</h1>
        <p>Quelque chose s'est mal passé de notre côté. Merci de réessayer dans quelques instants.</p>
        <div class="error-page__actions">
            <a class="btn btn--primary" href="{{ path('app_home') }}">Revenir à l'accueil</a>
        </div>
    </section>
{% endblock %}
