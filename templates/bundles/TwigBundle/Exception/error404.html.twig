{% extends 'base.html.twig' %}

{% block title %}Page introuvable — ScrutinClair{% endblock %}
{% block description %}La page demandée n'existe pas.{% endblock %}

{% block body %}
    <section class="error-page">
        <span class="error-page__code" aria-hidden="true">404</span>
        <h1>Cette page est introuvable</h1>
        <p>Le texte, le groupe ou la personnalité recherchée n'existe pas (ou plus) sur ScrutinClair.</p>
        <div class="error-page__actions">
            <a class="btn btn--primary" href="{{ path('app_home') }}">Rechercher un texte</a>
            <a class="btn btn--ghost" href="{{ path('app_partis') }}">Voir les groupes</a>
        </div>
    </section>
{% endblock %}
